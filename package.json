{
  "name": "mediconnect-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MediConnect Mobile App (Client) & Backend API (Server)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "client": "npm --prefix client start",
    "client:android": "npm --prefix client run android",
    "client:ios": "npm --prefix client run ios",
    "client:lint": "npm --prefix client run lint",
    "client:typecheck": "npm --prefix client run typecheck",
    "server": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server start",
    "server:typecheck": "npm --prefix server run typecheck",
    "install:all": "npm install"
  }
}
