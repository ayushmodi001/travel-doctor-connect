{
  "expo": {
    "name": "mediconnect",
    "slug": "mediconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0369a1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mediconnect.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MediConnect needs camera access for video consultations.",
        "NSMicrophoneUsageDescription": "MediConnect needs microphone access for video and audio consultations.",
        "NSLocationWhenInUseUsageDescription": "MediConnect uses your location to find nearby emergency services.",
        "NSPhotoLibraryUsageDescription": "MediConnect needs photo library access to upload profile images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0369a1"
      },
      "package": "com.mediconnect.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-camera",
      "expo-image-picker",
      "expo-av",
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id-here"
      }
    }
  }
}
